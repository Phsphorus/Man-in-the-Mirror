{
    "type": "origins:multiple",
    "name": "Trap in a Box",
    "description": "With this power toggled, you can right-click an entity to freeze it in an unpassable mirror, and it won't be able to escape until 10 seconds pass and the mirror shatters, dealing a little bit of damage.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/toggle.png",
            "text": "Toggle with %s."
        }
    ],
    "toggle_active": {
        "type": "origins:active_self",
        "key": {
            "key": "key.origins.secondary_active",
            "continuous": false
        },
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "phantom:trap_in_a_box_toggle",
                "comparison": "==",
                "compare_to": 0
            },
            "if_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "phantom:trap_in_a_box_toggle",
                        "change": 1
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "title @s actionbar {\"text\":\"Trap in a Box armed\",\"color\":\"aqua\"}"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "playsound minecraft:block.amethyst_block.chime player @s ~ ~ ~ 0.4 1.4"
                    }
                ]
            },
            "else_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "phantom:trap_in_a_box_toggle",
                        "change": 0,
                        "operation": "set"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "title @s actionbar {\"text\":\"Trap in a Box disarmed.\",\"color\":\"gray\"}"
                    }
                ]
            }
        }
    },
    "toggle": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "trap": {
        "type": "origins:action_on_entity_use",
        "bientity_condition": {
            "type": "origins:target_condition",
            "condition": {
                "type": "origins:origin",
                "origin": "phantom:mirror",
                "inverted": true
            }
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "phantom:trap_in_a_box_toggle",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:resource",
                    "resource": "phantom:trap_in_a_box_cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        },
        "action_result": "success",
        "priority": 10,
        "bientity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:trigger_cooldown",
                                "power": "phantom:trap_in_a_box_cooldown"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "phantom:trap_in_a_box_toggle",
                                "change": 0,
                                "operation": "set"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"Target trapped.\",\"color\":\"aqua\"}"
                            }
                        ]
                    }
                },
                {
                    "type": "origins:target_action",
                    "action": {
                        "type": "origins:execute_command",
                        "command": "power grant @s phantom:assign/trapped_in_a_box"
                    }
                }
            ]
        }
    },
    "cooldown": {
        "type": "origins:cooldown",
        "cooldown": 1200,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
            "bar_index": 9
        }
    }
}
